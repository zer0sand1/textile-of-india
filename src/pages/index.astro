---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const crafts = await getCollection("craft");
const places = await getCollection("place");
---

<BaseLayout title="Tana Bana — Textiles of India">
  <h1>Tana Bana — Textiles of India</h1>
  <p>A curated reference on India's textile traditions.</p>

  <h2>Crafts</h2>
  <ul>
    {
      crafts.map((c) => (
        <li>
          <a href={`/craft/${c.slug}/`}>{c.data.name}</a>
          &mdash; {c.data.summary}
        </li>
      ))
    }
  </ul>

  <h2>Places</h2>
  <ul>
    {places.map((p) => <li>{p.data.name} ({p.data.granularity})</li>)}
  </ul>
</BaseLayout>
